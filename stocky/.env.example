# Copy to stocky/.env and adjust. Every value below is also the built-in
# default, so the server runs fine without any .env file. Real environment
# variables always override this file. stocky/.env is gitignored.

# HTTP port for the Stocky API.
STOCKY_PORT=8080

# Postgres connection. The database must be named "assignment".
DATABASE_URL=postgres://postgres:postgres@localhost:5432/assignment?sslmode=disable

# Price vendor (the mock price server).
PRICE_SERVER_URL=http://localhost:8081
# How often the background job fetches prices (Go duration: 30s, 5m, 1h).
PRICE_FETCH_INTERVAL=1h
# A price older than this is reported as stale (and rejected for new rewards).
PRICE_STALE_AFTER=2h
# Timeout for each attempt against the price vendor (3 attempts per fetch).
PRICE_CLIENT_TIMEOUT=5s

# Flat brokerage in INR per purchase (a typical Rs 20 per order). Set 0 to
# model a zero-brokerage delivery broker.
FEE_BROKERAGE_FLAT=20

# trace, debug, info, warn, error
LOG_LEVEL=info
# debug, release or test
GIN_MODE=debug

# Not read by the server: integration tests use this database and skip
# themselves when it is unset. Export it in your shell to run them.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/assignment_test?sslmode=disable
