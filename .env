# Committed on purpose: the assignment asks for the .env file to be shared.
# Nothing here is a secret. Real environment variables override these values.

# ---- mock-price-server ----
PRICE_SERVER_PORT=8081
PRICE_TICK_INTERVAL=1m
PRICE_SERVER_START_DOWN=false
LOG_LEVEL=debug
GIN_MODE=debug
# Empty means /admin/* is open. Set a value to require the X-Admin-Token header.
ADMIN_TOKEN=
